# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────────────────────
# Public base URL of this deployment, used to build booking links, OAuth
# redirect URIs, and Postmark webhook target references.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Random 32+ byte secret used to sign booking links (HMAC) and OAuth state.
APP_SIGNING_SECRET=
# Set only while rotating APP_SIGNING_SECRET (see docs/SECRET_ROTATION.md)
# — the previous secret, kept just long enough that outstanding booking
# links keep verifying until they expire on their own.
APP_SIGNING_SECRET_PREVIOUS=

# ── Postmark (inbound intake + outbound replies) ────────────────────────
POSTMARK_SERVER_TOKEN=
# Shared secret checked against the inbound webhook Authorization header
# (Postmark inbound webhooks support HTTP basic auth — set the same value
# in the Postmark server's webhook URL as a query/basic-auth credential).
POSTMARK_INBOUND_WEBHOOK_SECRET=
POSTMARK_FROM_ADDRESS=admissions@example.org

# ── Claude (grounded field extraction) ──────────────────────────────────
# Optional. Without it, extraction falls back to a deterministic
# heuristic/regex parser — no inquiry is ever dropped for lack of a key.
ANTHROPIC_API_KEY=

# ── Google Calendar (per-school OAuth, configured at the app level) ─────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI on the Google OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# ── Airtable (lead-tracking sync) ───────────────────────────────────────
# Per-school base/table IDs live in school_integrations; this is the
# account-level PAT used to authenticate to Airtable's API.
AIRTABLE_PERSONAL_ACCESS_TOKEN=

# ── Observability ─────────────────────────────────────────────────────────
# Optional. Without it, errors are still logged (via Winston) but nothing
# alerts anyone in real time.
SENTRY_DSN=
# error | warn | info | http | debug. Defaults to "info".
LOG_LEVEL=info

# ── Rate limiting (Upstash Redis) ────────────────────────────────────────
# Optional for local dev; expected in production — without it, the
# Postmark webhook, booking-confirm, Google OAuth callback, and Stripe
# webhook endpoints are unthrottled. Free tier at upstash.com is plenty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Stripe (schools pay RoxAI for the platform) ──────────────────────────
# Optional. Without it, the billing settings page just shows
# "not configured" instead of a checkout/portal link.
STRIPE_SECRET_KEY=
# From the Stripe webhook endpoint's settings, after pointing it at
# /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=
# The Price ID (not Product ID) schools are charged under, e.g. a monthly
# subscription price created in the Stripe Dashboard.
STRIPE_PRICE_ID=
